# Copy to .env (never commit it) or to /etc/archer-router-mcp.env (mode 0600).
# Every value is a placeholder; 192.0.2.1 is an RFC 5737 documentation address.

# --- Router connection ----------------------------------------------------
ARCHER_ROUTER_HOST=192.0.2.1
ARCHER_ROUTER_PORT=443
ARCHER_ROUTER_PASSWORD=<your-router-password>
# Archer routers ship self-signed certificates, so verification is off by default.
ARCHER_ROUTER_VERIFY_TLS=false
# Optional: pin the router's certificate by SHA-256 fingerprint (hex, no colons).
# ARCHER_ROUTER_TLS_FINGERPRINT_SHA256=<fingerprint>
ARCHER_ROUTER_TIMEOUT_SECONDS=10

# --- Safety switches ------------------------------------------------------
# Writes need this AND confirm_write=true on each call.
ARCHER_ROUTER_ALLOW_WRITES=false
# Return the exact write request without sending it.
ARCHER_ROUTER_DRY_RUN=false
# Freeze authentication entirely: no login attempt is made while true.
ARCHER_ROUTER_LOGIN_DISABLED=false
# Failed logins tolerated per process before all logins are refused (1-5).
ARCHER_ROUTER_MAX_LOGIN_FAILURES=1
# Evict another logged-in admin by resending confirm=true. Off by default so the
# owner's browser session is never kicked without intent.
ARCHER_ROUTER_FORCE_SESSION_TAKEOVER=false
# Where the login breaker and rate-limit state are persisted.
# ARCHER_ROUTER_STATE_DIR=~/.local/state/archer-router-mcp
# Wire envelope: auto (https-plain over HTTPS, http-encrypted over HTTP) | https-plain |
# http-encrypted. Leave as auto unless an R0 capture says otherwise.
ARCHER_ROUTER_ENVELOPE=auto

# --- MCP server -----------------------------------------------------------
# stdio | streamable-http
ARCHER_MCP_TRANSPORT=stdio
ARCHER_MCP_HOST=127.0.0.1
ARCHER_MCP_PORT=8770
# ARCHER_MCP_LOG_LEVEL=INFO
